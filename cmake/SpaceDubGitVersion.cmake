#-----------------------------------------------------------------------------
# SpaceDub - stamp the git commit into a header, for the About box.
#
# Run as a script (cmake -P) on EVERY build by the SpaceDubGitVersion target
# in CMakeLists.txt - not just at configure time, or the About box would name
# whatever commit you last configured at. The header is only rewritten when
# its content changes, so an unchanged checkout rebuilds nothing.
#
#   -DSRC=<source dir>  -DOUT=<header to write>  -DGIT_EXECUTABLE=<git or empty>
#
# A build from a tarball, or with no git, gets an empty commit: the About box
# then says "not built from git".
#-----------------------------------------------------------------------------

set(commit "")
set(branch "")
set(dirty 0)

if(GIT_EXECUTABLE AND EXISTS "${SRC}/.git")
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" rev-parse --short=7 HEAD
                    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE
                    ERROR_QUIET RESULT_VARIABLE r)
    if(NOT r EQUAL 0)
        set(commit "")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" rev-parse --abbrev-ref HEAD
                    OUTPUT_VARIABLE branch OUTPUT_STRIP_TRAILING_WHITESPACE
                    ERROR_QUIET RESULT_VARIABLE r)
    if(NOT r EQUAL 0)
        set(branch "")
    endif()
    # Tracked files only: build/ and external/ are ignored anyway, and an
    # untracked scratch file should not mark a build "with local changes".
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" status --porcelain --untracked-files=no
                    OUTPUT_VARIABLE status OUTPUT_STRIP_TRAILING_WHITESPACE
                    ERROR_QUIET RESULT_VARIABLE r)
    if(r EQUAL 0 AND NOT status STREQUAL "")
        set(dirty 1)
    endif()
endif()

set(content "// Generated by cmake/SpaceDubGitVersion.cmake on every build - do not edit.
#pragma once
#define SPACEDUB_GIT_COMMIT \"${commit}\"
#define SPACEDUB_GIT_BRANCH \"${branch}\"
#define SPACEDUB_GIT_DIRTY  ${dirty}
")

set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUT}" "${content}")
endif()
